                                            <RadioButton x:Name="TipsDetailed" Content="Detalle" GroupName="TipsMode" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,3" Margin="0,0,4,0" FontSize="13" Checked="OnTipsModeChanged" />
                                        </WrapPanel>
                                        <ListBox x:Name="TipList" SelectionChanged="OnTipSelected">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Brush}" Margin="0,0,8,0" FontSize="14" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" />
                                                            <TextBlock Text="{Binding Why}" Visibility="{Binding WhyVisibility}" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding How}" Visibility="{Binding HowVisibility}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding Drill}" Visibility="{Binding WhyVisibility}" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                                                            <Button Tag="{Binding ExerciseId}" Visibility="{Binding ExerciseVisibility}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="10,3" Margin="0,5,0,2" FontSize="13" Click="OnPracticeExercise">
                                                                <TextBlock Text="{Binding ExerciseLabel}" TextWrapping="Wrap" Foreground="{DynamicResource OnFill}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
