                                <TabItem Header="FRENADAS">
                                    <ListBox x:Name="BrakeList" SelectionChanged="OnBrakeSelected" Margin="0,6,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="38" Height="38" Background="{Binding ScoreBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Score}" Style="{StaticResource Figure}" FontSize="18" Foreground="{DynamicResource OnFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" />
                                                        <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                                <TabItem Header="MÉTRICAS">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                        <Grid x:Name="StatsGrid" Margin="2,0,8,0" />
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= PROGRESO ======================= -->
            <TabItem x:Name="TabProgress" Header="PROGRESO">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CIRCUITOS Y TRAMOS" Style="{StaticResource H2}" Margin="4,0,0,6" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="4,0,0,10"
                                       Text="Cada sesión en el mismo circuito (o tramo) es un punto de tu evolución." />
                            <ListBox x:Name="ComboList" SelectionChanged="OnComboSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="220" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ProgressTitle" Text="Elige un circuito o tramo" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <ItemsControl x:Name="ProgressTips">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4,12,4">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Brush}" Margin="0,0,8,0" FontSize="14" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Tip.Detail}" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" />
                                                    <TextBlock Text="{Binding How}" Visibility="{Binding HowVisibility}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                                                    <Button Tag="{Binding ExerciseId}" Visibility="{Binding ExerciseVisibility}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="8,2" Margin="0,4,0,2" FontSize="12" Click="OnPracticeExercise">
                                                                    <TextBlock Text="{Binding ExerciseLabel}" TextWrapping="Wrap" />
                                                                </Button>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" CornerRadius="0" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                            <ui:TelemetryChart x:Name="ProgressChart" XUnit="ª sesión" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10" Height="230">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <Grid x:Name="ProgressGrid" Margin="0,0,8,0" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= CIRCUITOS ======================= -->
            <TabItem x:Name="TabTracks" Header="CIRCUITOS">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CIRCUITOS Y TRAMOS" Style="{StaticResource H2}" Margin="4,0,0,2" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="4,0,0,8" FontSize="12"
                                       Text="Primero los que ya has corrido; después, la biblioteca." />
                            <ListBox x:Name="TrackList" SelectionChanged="OnTrackSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="TrackHost" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ======================= ENTRENADOR ======================= -->
            <!-- ======================= COCHES ======================= -->
            <TabItem x:Name="TabCars" Header="COCHES">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="CarsHost" Margin="0,0,8,0" />
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabTrainer" Header="ENTRENADOR" Tag="PRACTICAR">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="VOLANTE Y PEDALES" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="WheelStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <StackPanel x:Name="InvertPanel" Visibility="Collapsed" Margin="0,2,0,4">
                                        <TextBlock Text="¿Un pedal marca al revés (100 % suelto)? Inviértelo:" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <WrapPanel>
                                            <Button Content="⇅ Freno" Tag="brake" Padding="8,3" Click="OnInvertPedal" />
                                            <Button Content="⇅ Acelerador" Tag="throttle" Padding="8,3" Click="OnInvertPedal" />
                                            <Button x:Name="InvertClutchButton" Content="⇅ Embrague" Tag="clutch" Padding="8,3" Click="OnInvertPedal" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="PedalSourceNow" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />

                                    <Border x:Name="CalibrationPanel" Visibility="Collapsed" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="CalibrationText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <ProgressBar x:Name="CalibrationProgress" Height="6" Maximum="1" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" Margin="0,0,0,8" />
                                            <TextBlock x:Name="CalibrationDone" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="CalibrationSkip" Content="No tengo embrague" Click="OnCalibrationSkip" />
                                                <Button Content="Cancelar" Click="OnCalibrationCancel" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="CalibrateButton" Content="🎯  Detectar pedales" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnCalibrateStart" />

                                    <TextBlock Text="Ejes en directo" Style="{StaticResource DimText}" Margin="0,8,0,4" />
                                    <ui:AxisMonitorControl x:Name="AxisMonitor" Margin="0,0,0,10" />

                                    <TextBlock Text="Usar los pedales de…" Style="{StaticResource DimText}" Margin="0,4,0,6" />
                                    <RadioButton x:Name="InputAuto" GroupName="TrainerInput" Foreground="{DynamicResource Text}" Margin="0,0,0,6" Checked="OnTrainerInputChanged">
                                        <TextBlock Text="Automático: el juego si estás en pista; si no, el volante (recomendado)" TextWrapping="Wrap" />
                                    </RadioButton>
                                    <RadioButton x:Name="InputWheel" GroupName="TrainerInput" Foreground="{DynamicResource Text}" Margin="0,0,0,6" Checked="OnTrainerInputChanged">
                                        <TextBlock Text="Siempre el volante USB" TextWrapping="Wrap" />
                                    </RadioButton>
                                    <RadioButton x:Name="InputGame" GroupName="TrainerInput" Foreground="{DynamicResource Text}" Margin="0,0,0,0" Checked="OnTrainerInputChanged">
                                        <TextBlock Text="Siempre el juego" TextWrapping="Wrap" />
                                    </RadioButton>

                                    <TextBlock Text="Tacto de los pedales (como en el juego)" Style="{StaticResource DimText}" Margin="0,14,0,6" />
                                    <StackPanel x:Name="FeelOptions" />
                                    <TextBlock x:Name="FeelInfo" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="EJERCICIOS DE PEDALES" Style="{StaticResource H2}" Margin="4,0,0,6" />
                                    <ListBox x:Name="ExerciseList" SelectionChanged="OnExerciseSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Best}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="TrainerStart" Content="▶  Empezar" Style="{StaticResource AccentButton}" Click="OnTrainerStart" Margin="0,0,8,0" />
                                    <Button x:Name="TrainerStop" Content="■  Parar" Click="OnTrainerStop" Margin="0" IsEnabled="False" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="ExerciseTitle" Text="Elige un ejercicio" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ExerciseDescription" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock x:Name="ExerciseWhy" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="0" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                            <ui:TrainerControl x:Name="Trainer" />
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="84" Height="84" CornerRadius="0" Background="{DynamicResource PanelAlt}" Margin="0,0,16,0">
                                    <TextBlock x:Name="TrainerScore" Text="--" Style="{StaticResource Figure}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TrainerResultTitle" Text="Resultado" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TrainerSummary" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                    <TextBlock x:Name="TrainerAdvice" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= APRENDER ======================= -->
            <TabItem x:Name="TabLearn" Header="APRENDER">
                <ContentControl x:Name="LearnHost" />
            </TabItem>

            <!-- ======================= OVERLAY ======================= -->
            <TabItem x:Name="TabOverlay" Header="OVERLAY" Tag="AJUSTES">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OVERLAY DE PEDALES" Style="{StaticResource H2}" />
                                    <CheckBox x:Name="OverlayEnabled" Content="Activar el overlay" Checked="OnOverlayEnabledChanged" Unchecked="OnOverlayEnabledChanged" />
                                    <CheckBox x:Name="AutoHideCheck" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged">
                                        <TextBlock TextWrapping="Wrap" Text="Mostrarlo sólo mientras conduces (se oculta en menús y en el escritorio)" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,12"
                                               Text="Mientras juegas, el overlay es transparente a los clics: no puedes tocarlo ni moverlo por accidente. Para colocarlo, desbloquéalo aquí; se vuelve a bloquear solo al minimizar o cerrar esta ventana." />
                                    <ToggleButton x:Name="EditToggle" Content="🔓  Desbloquear para mover y redimensionar" HorizontalAlignment="Left"
                                                  Checked="OnEditToggled" Unchecked="OnEditToggled" />
                                    <Border x:Name="EditHelp" Visibility="Collapsed" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="0" Padding="10" Margin="0,0,0,10">
                                        <TextBlock TextWrapping="Wrap" LineHeight="20"
                                                   Text="El overlay tiene ahora un marco amarillo. • Arrastra desde el centro para moverlo a cualquier parte (también a otro monitor). • Arrastra un borde o una esquina para cambiar el tamaño. • Rueda del ratón encima: más grande / más pequeño. • Flechas del teclado: mover 1 px (con Mayús, 10 px)." />
                                    </Border>
                                    <TextBlock Text="Posición rápida (en el monitor donde está el overlay)" Style="{StaticResource DimText}" Margin="0,8,0,6" />
                                    <UniformGrid Columns="3" Rows="3" Width="330" HorizontalAlignment="Left">
                                        <Button Content="↖ Arriba izq." Tag="Left,Top" Click="OnSnap" />
                                        <Button Content="↑ Arriba" Tag="Center,Top" Click="OnSnap" />
                                        <Button Content="↗ Arriba der." Tag="Right,Top" Click="OnSnap" />
                                        <Button Content="← Izquierda" Tag="Left,Center" Click="OnSnap" />
                                        <Button Content="• Centro" Tag="Center,Center" Click="OnSnap" />
                                        <Button Content="→ Derecha" Tag="Right,Center" Click="OnSnap" />
                                        <Button Content="↙ Abajo izq." Tag="Left,Bottom" Click="OnSnap" />
                                        <Button Content="↓ Abajo" Tag="Center,Bottom" Click="OnSnap" />
                                        <Button Content="↘ Abajo der." Tag="Right,Bottom" Click="OnSnap" />
                                    </UniformGrid>
                                    <WrapPanel x:Name="MonitorButtons" Margin="0,4,0,0" />

                                    <TextBlock Text="Posición y tamaño exactos (px)" Style="{StaticResource DimText}" Margin="0,10,0,6" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="X" Style="{StaticResource DimText}" />
                                            <TextBox x:Name="OverlayX" Width="70" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="Y" Style="{StaticResource DimText}" />
                                            <TextBox x:Name="OverlayY" Width="70" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="Ancho" Style="{StaticResource DimText}" />
                                            <TextBox x:Name="OverlayW" Width="70" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="Alto" Style="{StaticResource DimText}" />
                                            <TextBox x:Name="OverlayH" Width="70" />
                                        </StackPanel>
                                        <Button Content="Aplicar" VerticalAlignment="Bottom" Click="OnOverlayApplyNumbers" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="－ Más pequeño" Click="OnOverlaySmaller" />
                                        <Button Content="＋ Más grande" Click="OnOverlayBigger" />
                                        <Button Content="Restablecer" Click="OnOverlayReset" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="CONTENIDO" Style="{StaticResource H2}" />
                                    <CheckBox x:Name="ShowTraceCheck" Content="Gráfica de acelerador y freno" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" />
                                    <CheckBox x:Name="ShowBarsCheck" Content="Columnas de cada pedal" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" />
                                    <CheckBox x:Name="ShowClutchCheck" Content="Incluir embrague" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" />
                                    <CheckBox x:Name="ShowGearCheck" Content="Marcha y velocidad" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged" />
                                    <CheckBox x:Name="ShowDeltaCheck" Checked="OnOverlayOptionChanged" Unchecked="OnOverlayOptionChanged">
                                        <TextBlock TextWrapping="Wrap" Text="Diferencia con tu mejor vuelta (verde = vas más rápido)" />
                                    </CheckBox>

                                    <TextBlock x:Name="WindowSecondsLabel" Text="Historial de la gráfica" Style="{StaticResource DimText}" Margin="0,8,0,0" />
                                    <Slider x:Name="WindowSecondsSlider" Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySliderChanged" />
                                    <TextBlock x:Name="OpacityLabel" Text="Opacidad del fondo" Style="{StaticResource DimText}" />
                                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySliderChanged" />
                                    <TextBlock x:Name="WidthLabel" Text="Ancho" Style="{StaticResource DimText}" />
                                    <Slider x:Name="WidthSlider" Minimum="120" Maximum="3000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySliderChanged" />
                                    <TextBlock x:Name="HeightLabel" Text="Alto" Style="{StaticResource DimText}" />
                                    <Slider x:Name="HeightSlider" Minimum="50" Maximum="1200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySliderChanged" />
                                    <TextBlock x:Name="OverlayPosText" Style="{StaticResource DimText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PANTALLA EN EL TELÉFONO" Style="{StaticResource H2}" />
                                    <CheckBox x:Name="PhoneEnabled" Checked="OnPhoneChanged" Unchecked="OnPhoneChanged">
                                        <TextBlock TextWrapping="Wrap" Text="Usar el teléfono como pantalla (pedales, marcha, RPM, diferencia y próxima frenada)" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,8"
                                               Text="El teléfono tiene que estar en la misma Wi-Fi que el PC. Escanea el código con la cámara (o escribe la dirección en el navegador): no hace falta instalar nada. La primera vez Windows te preguntará si permites a APEX conectarse en tu red privada: di que sí. La dirección lleva un código secreto, así que nadie más de tu red puede verla." />
                                    <StackPanel x:Name="PhonePanel" Orientation="Horizontal" Visibility="Collapsed">
                                        <Border Background="White" CornerRadius="0" Padding="6" Margin="0,0,12,0">
                                            <Image x:Name="PhoneQr" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" MaxWidth="320">
                                            <TextBox x:Name="PhoneUrl" IsReadOnly="True" FontSize="14" Margin="0,0,0,6" />
                                            <TextBlock x:Name="PhoneStatus" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="PhoneError" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="TARJETA DE INFORMACIÓN (CIRCUITO Y RECOMENDACIÓN)" Style="{StaticResource H2}" />
                                    <CheckBox x:Name="InfoCardEnabled" Content="Mostrarla sobre el juego" Checked="OnInfoCardChanged" Unchecked="OnInfoCardChanged" />
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,8"
                                               Text="Una tarjeta pequeña, como la de Steam: aparece sola unos segundos al entrar en una sesión y mientras estás en boxes, con el circuito, la categoría y con qué coche eres más rápido ahí. Pulsa la combinación para ampliarla con la información del circuito, y otra vez para ocultarla. El juego también recibe las teclas: si allí hacen algo, elige otra. Mayús+Tab abre el overlay de Steam en los juegos de Steam (ACC, Assetto Corsa)." />
                                    <TextBlock Text="Esquina" Style="{StaticResource DimText}" />
                                    <WrapPanel x:Name="InfoCornerChips" Margin="0,4,0,4" />
                                    <TextBlock Text="Combinación para ampliar u ocultar" Style="{StaticResource DimText}" />
                                    <WrapPanel x:Name="InfoKeyChips" Margin="0,4,0,4" />
                                    <Button Content="Ver cómo queda (8 s)" HorizontalAlignment="Left" Click="OnInfoCardPreview" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SI EL OVERLAY NO SE VE ENCIMA DEL JUEGO" Style="{StaticResource H2}" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" LineHeight="19"
                                               Text="Windows sólo deja dibujar encima de un juego en modo «Ventana sin bordes» (Borderless / Pantalla completa en ventana). En «Pantalla completa» exclusiva el juego tapa todo. Cámbialo en las opciones gráficas: ACC → Vídeo → Modo de pantalla: Ventana sin bordes · DiRT Rally 2.0 → Opciones → Ajustes gráficos → Modo de pantalla: Ventana sin bordes · EA WRC → Ajustes → Vídeo → Modo de pantalla: Ventana sin bordes · Forza → Vídeo → Modo de pantalla: Ventana / Sin bordes · iRacing: desactiva «Full Screen» en Opciones → Gráficos." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= JUEGOS ======================= -->
            <TabItem x:Name="TabGames" Header="JUEGOS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="1000" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Accent}">
                            <TextBlock TextWrapping="Wrap" LineHeight="19"
                                       Text="Importante: DiRT Rally y EA WRC sólo leen la configuración de telemetría al arrancar. Configúralos con el juego CERRADO (o ciérralo y vuelve a abrirlo después). Pulsa «Comprobar» para ver si cada juego está listo." />
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DIRT RALLY / DIRT RALLY 2.0 / DIRT 4" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,0,0,10"
                                           Text="Activa la telemetría UDP en Documentos\My Games\&lt;juego&gt;\hardwaresettings\hardware_settings_config.xml (udp enabled=&quot;true&quot; extradata=&quot;3&quot;). APEX lo modifica por ti y guarda una copia de seguridad." />
                                <TextBlock x:Name="DirtStatus" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Configurar DiRT Rally automáticamente" Style="{StaticResource AccentButton}" Click="OnConfigureDirt" />
                                    <Button Content="Comprobar" Click="OnCheckGames" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="EA SPORTS WRC" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,0,0,10"
                                           Text="APEX instala su propio formato de paquete (udp\simtelemetry.json, con posición del coche para el mapa) y lo activa en config.json sin tocar otros programas que ya tengas configurados." />
                                <TextBlock x:Name="WrcStatus" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Configurar EA WRC automáticamente" Style="{StaticResource AccentButton}" Click="OnConfigureWrc" />
                                    <Button Content="Comprobar" Click="OnCheckGames" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="FORZA MOTORSPORT (2023), FORZA MOTORSPORT 7, FORZA HORIZON 4 / 5" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}"
                                           Text="1) En el juego: Ajustes → Interfaz y juego (HUD and Gameplay) → Salida de datos (Data Out): ACTIVADO · IP 127.0.0.1 · Puerto 5300 · Formato «Aceleración de auto» (Car Dash; no «Trineo»)." />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,8,0,8"
                                           Text="2) Versión Microsoft Store / Game Pass: Windows bloquea que la app del juego envíe datos a tu propio PC. El botón da ese permiso (Windows te pedirá confirmación de administrador). Sólo hace falta una vez." />
                                <TextBlock x:Name="ForzaStatus" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ForzaPermissionButton" Content="Dar permiso de red a Forza" Style="{StaticResource AccentButton}" Click="OnForzaPermission" />
                                    <Button Content="Comprobar" Click="OnCheckGames" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ASSETTO CORSA COMPETIZIONE · ASSETTO CORSA · IRACING" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}"
                                           Text="No necesitan configuración: APEX lee su memoria compartida oficial en cuanto sales a pista. En ACC la longitud de cada circuito se mide sola en tu primera vuelta completa." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BEAMNG.DRIVE · LIVE FOR SPEED (OUTGAUGE)" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}"
                                           Text="BeamNG: Opciones → Otros → Protocolos → OutGauge: activado, IP 127.0.0.1, puerto 4444. LFS: en cfg.txt pon OutGauge Mode 1, OutGauge IP 127.0.0.1, OutGauge Port 4444. Estos juegos no envían datos de vuelta, así que se graban como recorridos continuos." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,0,0,8"
                                           Text="Paquetes recibidos por cada lector desde que abriste la app. Si un juego está abierto en pista y su contador no sube, el juego no está enviando datos (configuración, permiso o puerto)." />
                                <ItemsControl x:Name="DiagnosticsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Packets}" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Abrir registro de diagnóstico" HorizontalAlignment="Left" Margin="0,10,8,0" Click="OnOpenLog" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PUERTOS UDP" Style="{StaticResource H2}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,0,0,10"
                                           Text="Cámbialos sólo si otro programa (SimHub, un volante con pantalla…) ya usa ese puerto. Si cambias el de DiRT o WRC, vuelve a pulsar su botón de configuración." />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="DiRT Rally" Style="{StaticResource DimText}" />
                                        <TextBox x:Name="PortDirt" Width="110" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="EA WRC" Style="{StaticResource DimText}" />
                                        <TextBox x:Name="PortWrc" Width="110" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Forza" Style="{StaticResource DimText}" />
                                        <TextBox x:Name="PortForza" Width="110" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="OutGauge" Style="{StaticResource DimText}" />
                                        <TextBox x:Name="PortOutGauge" Width="110" />
                                    </StackPanel>
                                </WrapPanel>
                                <Button Content="Aplicar puertos" HorizontalAlignment="Left" Click="OnApplyPorts" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ConfigResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= APARIENCIA ======================= -->
            <TabItem x:Name="TabAppearance" Header="APARIENCIA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="1000" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TEMA" Style="{StaticResource H2}" />
                                <WrapPanel>
                                    <RadioButton x:Name="ThemeDark" Content="🌙  Oscuro" GroupName="Theme" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnThemeModeChanged" />
                                    <RadioButton x:Name="ThemeLight" Content="☀  Claro" GroupName="Theme" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnThemeModeChanged" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                           Text="El oscuro cansa menos la vista con poca luz o con la app al lado del juego; el claro se lee mejor de día." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="COLOR" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Se usa en los botones, la pestaña abierta y lo que seleccionas, y el fondo de la ventana toma un tono del mismo color." />
                                <WrapPanel x:Name="ThemeColors" />
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                           Text="No cambian el overlay sobre el juego ni los colores que significan algo (verde acelerador, rojo freno, ámbar aviso): se leen igual con cualquier color." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
