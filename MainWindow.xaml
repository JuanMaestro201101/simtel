<Window x:Class="SimTelemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SimTelemetry.UI"
        Title="APEX" Width="1400" Height="840" MinWidth="1120" MinHeight="620"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{DynamicResource Bg}">
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" Padding="16,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Image x:Name="LogoImage" Width="30" Height="30" Margin="0,0,10,0" />
                    <TextBlock Text="APEX" Style="{StaticResource Figure}" FontSize="26" VerticalAlignment="Center" />
                </StackPanel>
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Off}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Esperando un juego…" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,12,0">
                    <TextBlock Text="PERFIL" Style="{StaticResource H2}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <WrapPanel x:Name="ProfileChips" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProfileNote" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <CheckBox x:Name="AutoProfileCheck" Content="Cambiar solo al abrir un juego" FontSize="12" VerticalAlignment="Center" Margin="0"
                              Checked="OnAutoProfileChanged" Unchecked="OnAutoProfileChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" Padding="14,0,14,14" SelectionChanged="OnTabChanged" ItemContainerStyle="{StaticResource NavTab}">
            <!-- ======================= EN VIVO ======================= -->
            <TabItem x:Name="TabLive" Header="EN VIVO">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border x:Name="OnboardingCard" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ocultar" Padding="8,2" Margin="0" Click="OnOnboardingHide" />
                                    <TextBlock Text="PRIMEROS PASOS" Style="{StaticResource H2}" />
                                </DockPanel>
                                <ItemsControl x:Name="OnboardingSteps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3,0,3">
                                                <Button DockPanel.Dock="Right" Content="{Binding Action}" Tag="{Binding Target}" Visibility="{Binding ActionVisibility}" Padding="8,2" Margin="8,0,0,0" Click="OnOnboardingAction" />
                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontWeight="Bold" Width="22" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="LiveGame" Text="Ningún juego conectado" Style="{StaticResource Figure}" FontWeight="SemiBold" FontSize="26" />
                                <TextBlock x:Name="LiveTrack" Style="{StaticResource DimText}" Margin="0,2,0,14" TextWrapping="Wrap" Text="Abre un juego compatible y sal a pista." />
                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Velocidad" Style="{StaticResource DimText}" />
                                        <TextBlock x:Name="LiveSpeed" Text="--" Style="{StaticResource Figure}" FontSize="32" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Marcha" Style="{StaticResource DimText}" />
                                        <TextBlock x:Name="LiveGear" Text="-" Style="{StaticResource Figure}" FontSize="32" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="RPM" Style="{StaticResource DimText}" />
                                        <TextBlock x:Name="LiveRpm" Text="--" Style="{StaticResource Figure}" FontSize="32" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Vuelta / tramo" Style="{StaticResource DimText}" />
                                        <TextBlock x:Name="LiveLapTime" Text="--" Style="{StaticResource Figure}" FontSize="32" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Distancia" Style="{StaticResource DimText}" />
                                        <TextBlock x:Name="LiveDistance" Text="--" Style="{StaticResource Figure}" FontSize="32" />
                                    </StackPanel>
                                </UniformGrid>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="LivePedalSource" DockPanel.Dock="Right" Style="{StaticResource DimText}" />
                                    <TextBlock Text="Acelerador y freno (así se verá el overlay)" Style="{StaticResource DimText}" />
                                </DockPanel>
                                <Border Background="{StaticResource OverlayPanel}" CornerRadius="0">
                                    <ui:PedalOverlayControl x:Name="LivePedals" Height="170" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SessionCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Ver guía del circuito" VerticalAlignment="Top" Click="OnOpenTrackGuide" />
                                <StackPanel>
                                    <TextBlock Text="SESIÓN ACTUAL" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="SessionTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SessionHeadline" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="SessionRanking" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GRABACIÓN" Style="{StaticResource H2}" />
                                <CheckBox x:Name="RecordCheck" Content="Grabar vueltas y tramos automáticamente" Checked="OnRecordChanged" Unchecked="OnRecordChanged" />
                                <TextBlock x:Name="RecordStatus" Style="{StaticResource DimText}" Text="" Margin="0,0,0,4" />
                                <TextBlock x:Name="LastLapText" Text="" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Abrir carpeta de datos" Click="OnOpenDataFolder" />
                                    <Button Content="Ver análisis" Click="OnGoToAnalysis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="JUEGOS" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="APEX escucha todos los juegos a la vez y usa el que esté enviando datos." />
                            <ItemsControl x:Name="SourceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" CornerRadius="0" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding DotBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" />
                                                    <TextBlock Text="{Binding Packets}" Style="{StaticResource DimText}" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= INGENIERO ======================= -->
            <TabItem x:Name="TabEngineer" Header="INGENIERO">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="INGENIERO DE CARRERA" Style="{StaticResource H2}" />
                                    <CheckBox x:Name="EngEnabled" Checked="OnEngineerOptionChanged" Unchecked="OnEngineerOptionChanged">
                                        <TextBlock TextWrapping="Wrap" Text="Activar el ingeniero (te habla por los auriculares mientras conduces)" />
                                    </CheckBox>
                                    <CheckBox x:Name="EngBeeps" Content="Pitidos antes de cada frenada: bip · bip · biiip = ¡frena!" Checked="OnEngineerOptionChanged" Unchecked="OnEngineerOptionChanged" />
                                    <CheckBox x:Name="EngVoice" Checked="OnEngineerOptionChanged" Unchecked="OnEngineerOptionChanged">
                                        <TextBlock TextWrapping="Wrap" Text="Voz: intensidad y marcha de cada curva, tiempo de vuelta, dónde pierdes y presiones" />
                                    </CheckBox>
                                    <CheckBox x:Name="EngRallyCalls" Checked="OnEngineerOptionChanged" Unchecked="OnEngineerOptionChanged">
                                        <TextBlock TextWrapping="Wrap" Text="En rally (DiRT Rally, EA WRC), también voz en las curvas («Fuerte 90»). Por defecto sólo pitidos: tu copiloto ya canta las notas y las voces se pisarían." />
                                    </CheckBox>
                                    <CheckBox x:Name="EngProgressive" Checked="OnEngineerOptionChanged" Unchecked="OnEngineerOptionChanged">
                                        <TextBlock TextWrapping="Wrap" Text="Objetivo progresivo: en las curvas donde eres constante, el aviso llega unos metros más tarde que tu mejor vuelta (la mitad del margen que tu coche permite, como mucho 15 m). Cuando lo consigues, tu nueva mejor vuelta trae el siguiente paso." />
                                    </CheckBox>
                                    <TextBlock x:Name="EngVolumeLabel" Text="Volumen" Style="{StaticResource DimText}" Margin="0,8,0,0" />
                                    <Slider x:Name="EngVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnEngineerVolumeChanged" />
                                    <TextBlock x:Name="EngDelayLabel" Text="Adelanto de los avisos" Style="{StaticResource DimText}" />
                                    <Slider x:Name="EngDelay" Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnEngineerDelayChanged" />
                                    <WrapPanel>
                                        <Button Content="Auriculares con cable / USB" Tag="80" Padding="8,3" Click="OnEngineerDelayPreset" />
                                        <Button Content="Auriculares Bluetooth" Tag="250" Padding="8,3" Click="OnEngineerDelayPreset" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                                               Text="Los auriculares Bluetooth retrasan el sonido unos 0,2 s (a 250 km/h son 15 m). Este adelanto hace que el pitido largo suene justo en el punto de frenada." />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="🔊  Probar sonido" Click="OnEngineerTest" />
                                    </StackPanel>
                                    <TextBlock x:Name="EngVoiceInfo" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,0" />

                                    <TextBlock Text="Voz del ingeniero" Style="{StaticResource DimText}" Margin="0,12,0,4" />
                                    <WrapPanel x:Name="EngVoices" />
                                    <TextBlock x:Name="EngRateLabel" Text="Velocidad de la voz" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                                    <Slider x:Name="EngRate" Minimum="80" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnEngineerVoiceSlider" />
                                    <TextBlock x:Name="EngPitchLabel" Text="Tono de la voz" Style="{StaticResource DimText}" />
                                    <Slider x:Name="EngPitch" Minimum="70" Maximum="130" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnEngineerVoiceSlider" />
                                    <WrapPanel>
                                        <Button Content="Instalar más voces (Windows)" Padding="8,3" Click="OnInstallVoices" />
                                        <Button Content="⟳ Actualizar lista" Padding="8,3" Click="OnRefreshVoices" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" FontSize="12"
                                               Text="Las voces «clásicas» son las de siempre de Windows; las demás son las modernas (más naturales, y con los avisos de cada curva preparados de antemano para que suenen al instante). Para más voces en español (por ejemplo de España), instálalas en Windows y pulsa «Actualizar lista»." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="CÓMO TE AYUDA" Style="{StaticResource H2}" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="20"
                                               Text="Usa como referencia tu vuelta válida más rápida en ese circuito o tramo (con el mismo coche si la tienes). Unos 3 s antes de cada frenada te dice cuánto frenar y con qué presión de pedal, y la marcha de la curva: «Frena fuerte, 90 por ciento, segunda». Después suenan dos pitidos cortos (a 1 s y a 0,5 s) y uno largo justo donde frenaste en tu mejor vuelta: cuanto más agudo y largo, más fuerte la frenada." />
                                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"
                                               Text="Al cruzar la meta te dice el tiempo, la diferencia con tu mejor vuelta y la curva donde más pierdes (frenas antes, pasas más lento…). En ACC también te avisa del combustible que queda y de las presiones. Cuando mejoras tu vuelta, los avisos pasan a usar la nueva." />
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"
                                               Text="Necesita un juego que envíe la distancia recorrida: ACC, Assetto Corsa, iRacing, DiRT Rally, EA WRC o Forza con «Data Out». En rally funciona como unas notas de frenada del tramo que ya corriste." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="NEUMÁTICOS (PRESIÓN EN CALIENTE)" Style="{StaticResource H2}" />
                                    <UniformGrid Columns="2" Width="260" HorizontalAlignment="Left">
                                        <Border Background="{DynamicResource PanelAlt}" CornerRadius="0" Margin="0,0,6,6" Padding="10,6">
                                            <StackPanel><TextBlock Text="Del. izq." Style="{StaticResource DimText}" /><TextBlock x:Name="TyreFL" Text="--" Style="{StaticResource Figure}" FontSize="26" /></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelAlt}" CornerRadius="0" Margin="0,0,0,6" Padding="10,6">
                                            <StackPanel><TextBlock Text="Del. der." Style="{StaticResource DimText}" /><TextBlock x:Name="TyreFR" Text="--" Style="{StaticResource Figure}" FontSize="26" /></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelAlt}" CornerRadius="0" Margin="0,0,6,0" Padding="10,6">
                                            <StackPanel><TextBlock Text="Tras. izq." Style="{StaticResource DimText}" /><TextBlock x:Name="TyreRL" Text="--" Style="{StaticResource Figure}" FontSize="26" /></StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelAlt}" CornerRadius="0" Padding="10,6">
                                            <StackPanel><TextBlock Text="Tras. der." Style="{StaticResource DimText}" /><TextBlock x:Name="TyreRR" Text="--" Style="{StaticResource Figure}" FontSize="26" /></StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock x:Name="TyreInfo" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="ACC: objetivo en seco 26,0–27,0 psi en caliente (GT3 y GT4). Cada 0,1 psi en frío cambia más o menos 0,1 psi en caliente; el ingeniero te avisa desde la segunda vuelta completa. Otros juegos no envían la presión." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PLAN DE FRENADAS" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="EngPlanTitle" TextWrapping="Wrap" Text="Sin referencia: conduce y el ingeniero usará tu mejor vuelta." />
                                    <TextBlock x:Name="EngNext" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <Border x:Name="EngPracticeBox" Visibility="Collapsed" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="0" Padding="10,6" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Salir del modo práctica" Padding="8,2" Margin="0" Click="OnPracticeStop" />
                                            <TextBlock x:Name="EngPracticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ItemsControl x:Name="EngCues">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelAlt}" CornerRadius="0" Padding="10,6" Margin="0,0,0,4">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="{Binding PracticeLabel}" Tag="{Binding Corner}" Padding="8,2" Margin="8,0,0,0" FontSize="12" Click="OnPracticeCorner" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Right}" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Left}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="LO ÚLTIMO QUE TE HA DICHO" Style="{StaticResource H2}" />
                                    <ItemsControl x:Name="EngHistory">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= ANÁLISIS ======================= -->
            <TabItem x:Name="TabAnalysis" Header="ANÁLISIS" Tag="ANALIZAR">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" MinWidth="400" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <!-- Sesiones y torre de vueltas -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="4,0,0,6">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="⟳" ToolTip="Actualizar lista" Padding="8,2" Margin="0" Click="OnRefreshLaps" />
                                    <TextBlock Text="SESIONES" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel x:Name="GameChips" />
                                <WrapPanel x:Name="TrackChips" />
                                <WrapPanel x:Name="CategoryChips" />
                            </StackPanel>
                            <ListBox x:Name="SessionList" Grid.Row="1" SelectionChanged="OnSessionSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="VUELTAS" Style="{StaticResource H2}" Margin="4,12,0,4" />
                            <Grid Grid.Row="3" Margin="8,0,8,4" TextElement.FontFamily="{StaticResource Display}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VTA" Style="{StaticResource DimText}" FontStretch="Condensed" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="TIEMPO" Style="{StaticResource DimText}" FontStretch="Condensed" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="DIF." Style="{StaticResource DimText}" FontStretch="Condensed" FontSize="12" />
                            </Grid>
                            <ListBox x:Name="LapList" Grid.Row="4" SelectionChanged="OnLapSelected">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="7,4" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="ToolTip" Value="{Binding Note}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid TextElement.FontFamily="{StaticResource Mono}" TextElement.FontSize="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Num}" Foreground="{Binding NumBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{Binding TimeBrush}" FontWeight="{Binding TimeWeight}" TextDecorations="{Binding Strike}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Diff}" Foreground="{Binding DiffBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="5" Margin="0,8,0,0">
                                <Button x:Name="SetRefButton" Content="Usar como referencia" Click="OnSetReference" />
                                <Button x:Name="ClearRefButton" Content="Referencia automática" Click="OnClearReference" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Vuelta elegida: tiempo, diferencia, sectores y gráficas -->
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="240" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="AnalysisTitle" Text="SELECCIONA UNA VUELTA" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis" />
                                    <WrapPanel>
                                        <TextBlock x:Name="LapBigTime" Style="{StaticResource Figure}" FontSize="46" Margin="0,0,16,0" />
                                        <TextBlock x:Name="LapBigDelta" Style="{StaticResource Figure}" FontSize="28" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                    </WrapPanel>
                                    <TextBlock x:Name="AnalysisSubtitle" Style="{StaticResource DimText}" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,2,0,0" HorizontalAlignment="Right">
                                    <Border x:Name="RefChip" Background="{DynamicResource ReferenceTint}" Padding="10,4" HorizontalAlignment="Right" Visibility="Collapsed">
                                        <TextBlock x:Name="RefChipText" Foreground="{DynamicResource Reference}" FontFamily="{StaticResource Display}" FontStretch="Condensed" FontWeight="SemiBold" FontSize="14" />
                                    </Border>
                                    <TextBlock x:Name="RefLine" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="14" Margin="0,5,0,0" Style="{StaticResource DimText}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource DimText}" FontSize="11" Margin="0,8,0,0"
                                               Text="Gráficas y mapa: rueda = zoom · arrastrar = mover · doble clic = ver todo" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid x:Name="SectorRow" Grid.Row="1" Rows="1" Margin="0,0,0,10" />

                        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                            <ui:TelemetryChart x:Name="Chart" />
                        </Border>
                    </Grid>

                    <!-- Trazada con zoom y qué mejorar -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="220" />
                            <RowDefinition Height="1.15*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
